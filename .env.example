# Copie para .env (ignorado pelo git). Usado pelo docker compose e pela API.
NODE_ENV=development
PORT=3000

# Portas publicadas no host (padroes escolhidos para nao colidir com 5432/6379/8025/1025)
POSTGRES_PORT=5434
REDIS_PORT=6381
MAILPIT_WEB_PORT=8026
MAILPIT_SMTP_PORT=1026

POSTGRES_USER=DSIN
POSTGRES_PASSWORD=DSIN
POSTGRES_DB=DSIN
DATABASE_URL=postgresql://DSIN:DSIN@localhost:5434/DSIN

# Autenticacao. Segredos com no minimo 32 caracteres; gere os seus com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-do-jwt-por-um-valor-longo-e-aleatorio
COOKIE_SECRET=troque-este-segredo-do-cookie-por-um-valor-longo-e-aleatorio
# true apenas quando servido por HTTPS (o Safari nao aceita cookie Secure em http://localhost)
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Fuso do salao, como offset fixo de UTC em horas (agenda, regra dos 2 dias, sugestao da mesma semana)
SALON_UTC_OFFSET_HOURS=-3

# Seed: cria a dona do salao (ADMIN), um cliente de demonstracao, servicos e profissionais (idempotente)
ADMIN_NAME=Leila
ADMIN_EMAIL=leila@cabeleleila.local
ADMIN_PASSWORD=Leila@12345
CLIENT_NAME="Maria Cliente"
CLIENT_EMAIL=cliente@cabeleleila.local
CLIENT_PASSWORD=Cliente@12345
